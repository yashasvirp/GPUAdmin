# Cluster-specific configuration for this deployment.
# Copy this file to .env (in the same directory) and fill in your real
# cluster's numbers before your first deploy. .env is gitignored — it's
# deployment-specific config, not code, and shouldn't be committed.
#
# If .env doesn't exist, docker-compose.prod.yml falls back to these
# same default values, so nothing breaks if you skip this step.
#
# Changing these values later, on a deployment that already has real
# usage history, doesn't reset anything — existing GPU-hours already
# consumed get reinterpreted against the new total, which can produce
# confusing percentages. Set these once, before your first deploy.

TOTAL_GPUS=20
TOTAL_BUDGET=43200
